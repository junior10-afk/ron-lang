// Bindings for ron_engine.dll (Vulkan renderer, window, input, audio) plus a
// few Ron-side helpers. `ronc` copies the DLL next to your executable.

import "std/math.ron";
import "std/mem.ron";

extern "ron_engine.dll" {
    fn engine_init(int width, int height, u8* title) -> bool;
    fn engine_shutdown();
    fn engine_running() -> bool;
    fn engine_begin_frame(float r, float g, float b) -> bool;
    fn engine_end_frame();
    fn engine_set_title(u8* title);
    fn engine_width() -> int;
    fn engine_height() -> int;
    fn engine_aspect() -> float;
    fn engine_screenshot(u8* bmp_path);

    fn engine_time() -> f64;
    fn engine_delta() -> float;
    fn engine_fps() -> float;

    fn engine_set_camera(Mat4* view, Mat4* proj, Vec3* eye);
    fn engine_set_light(float dx, float dy, float dz, float intensity);
    fn engine_set_light_color(float r, float g, float b);
    fn engine_set_ambient(float sky_r, float sky_g, float sky_b, float ground_r, float ground_g, float ground_b);
    fn engine_set_fog(float r, float g, float b, float density);
    fn engine_set_material(float roughness, float metallic, float emissive, float world_uv_scale);

    fn engine_mesh_cube() -> int;
    fn engine_mesh_sphere(int rings, int segments) -> int;
    fn engine_mesh_plane(float size) -> int;
    // 8 floats per vertex: position, normal, uv
    fn engine_mesh_create(float* vertices, int vertex_count, u32* indices, int index_count) -> int;
    // 16 floats per vertex: position, normal, uv, 4 joint indices, 4 weights
    fn engine_mesh_create_skinned(float* vertices, int vertex_count, u32* indices, int index_count) -> int;

    fn engine_texture_load(u8* png_path) -> int;
    fn engine_texture_create(int width, int height, u8* rgba) -> int;

    fn engine_draw(int mesh, Mat4* model, float r, float g, float b);
    fn engine_draw_checker(int mesh, Mat4* model, float r, float g, float b);
    fn engine_draw_textured(int mesh, Mat4* model, int texture, float r, float g, float b);
    fn engine_draw_skinned(int mesh, Mat4* model, Mat4* joints, int joint_count, int texture, float r, float g, float b);

    fn engine_model_load(u8* gltf_path) -> int;
    fn engine_model_animation_count(int model) -> int;
    fn engine_model_animation_duration(int model, int anim) -> float;
    fn engine_model_find_animation(int model, u8* name) -> int;
    fn engine_draw_model(int model, Mat4* transform, int anim, float time);
    fn engine_draw_model_blend(int model, Mat4* transform, int anim_a, float time_a, int anim_b, float time_b, float weight);
    fn engine_model_bounds(int model, Vec3* min, Vec3* max);

    fn engine_model_material_count(int model) -> int;
    fn engine_model_material_name(int model, int material) -> u8*;
    fn engine_model_find_material(int model, u8* name) -> int;
    fn engine_model_set_material_flags(int model, int material, int flags);
    fn engine_model_set_material_color(int model, int material, float r, float g, float b, float a);
    fn engine_model_set_material_pbr(int model, int material, float roughness, float metallic);

    fn engine_model_morph_count(int model) -> int;
    fn engine_model_morph_name(int model, int morph) -> u8*;
    fn engine_model_find_morph(int model, u8* name) -> int;
    fn engine_model_set_morph(int model, int morph, float weight);
    fn engine_model_clear_morphs(int model);

    fn engine_environment_load(u8* path) -> bool;
    fn engine_environment_intensity(float intensity);
    fn engine_environment_background(bool show);
    fn engine_environment_clear();

    fn engine_key_down(int key) -> bool;
    fn engine_key_pressed(int key) -> bool;
    fn engine_mouse_down(int button) -> bool;
    fn engine_mouse_pressed(int button) -> bool;
    fn engine_mouse_dx() -> float;
    fn engine_mouse_dy() -> float;
    fn engine_mouse_wheel() -> float;

    fn engine_play_tone(float frequency, float seconds, float volume, int wave);
    fn engine_play_sweep(float from_hz, float to_hz, float seconds, float volume, int wave);
}

// Key codes (Windows virtual keys)
const int KEY_BACKSPACE = 8;
const int KEY_TAB = 9;
const int KEY_ENTER = 13;
const int KEY_SHIFT = 16;
const int KEY_CTRL = 17;
const int KEY_ESCAPE = 27;
const int KEY_SPACE = 32;
const int KEY_LEFT = 37;
const int KEY_UP = 38;
const int KEY_RIGHT = 39;
const int KEY_DOWN = 40;
const int KEY_0 = 48;
const int KEY_1 = 49;
const int KEY_2 = 50;
const int KEY_3 = 51;
const int KEY_A = 65;
const int KEY_D = 68;
const int KEY_E = 69;
const int KEY_F = 70;
const int KEY_Q = 81;
const int KEY_R = 82;
const int KEY_S = 83;
const int KEY_W = 87;

// Material shading models for engine_model_set_material_flags
const int SHADING_DEFAULT = 0;
const int SHADING_SKIN = 16;   // subsurface scattering approximation
const int SHADING_HAIR = 64;   // anisotropic strand highlight

const int MOUSE_LEFT = 0;
const int MOUSE_RIGHT = 1;
const int MOUSE_MIDDLE = 2;

const int WAVE_SINE = 0;
const int WAVE_SQUARE = 1;
const int WAVE_SAW = 2;
const int WAVE_NOISE = 3;

struct Color { float r, g, b; }

fn rgb(float r, float g, float b) -> Color { return Color{r, g, b}; }

fn draw(int mesh, Mat4 model, Color c) { engine_draw(mesh, &model, c.r, c.g, c.b); }

// An orbit camera around a target point (drag with the right mouse button, wheel to zoom).
struct OrbitCamera {
    Vec3 target;
    float yaw, pitch, distance;
    float fov;
}

fn orbit_camera(Vec3 target, float distance) -> OrbitCamera {
    return OrbitCamera{target, 0.6, 0.45, distance, radians(60.0)};
}

fn eye(OrbitCamera* cam) -> Vec3 {
    float cp = cos(cam.pitch);
    return cam.target + vec3(sin(cam.yaw) * cp, sin(cam.pitch), cos(cam.yaw) * cp) * cam.distance;
}

fn update(OrbitCamera* cam) {
    if (engine_mouse_down(MOUSE_RIGHT)) {
        cam.yaw -= engine_mouse_dx() * 0.005;
        cam.pitch += engine_mouse_dy() * 0.005;
    }
    cam.pitch = clamp(cam.pitch, -1.2, 1.45);
    cam.distance = clamp(cam.distance * (1.0 - engine_mouse_wheel() * 0.1), 0.25, 200.0);
}

fn apply(OrbitCamera* cam) {
    Vec3 e = cam.eye();
    Mat4 view = mat4_look_at(e, cam.target, vec3(0.0, 1.0, 0.0));
    Mat4 proj = mat4_perspective(cam.fov, engine_aspect(), 0.1, 500.0);
    engine_set_camera(&view, &proj, &e);
}

// ───────────── Materials ─────────────

struct Material {
    int texture;      // 0 = none (white)
    Color color;
    float roughness;  // 0 = mirror, 1 = chalk
    float metallic;   // 0 = dielectric, 1 = metal
    float emissive;   // glow strength
    float uv_scale;   // > 0: texture mapped in world space, repeating every 1/uv_scale units
}

fn material(Color c, float roughness, float metallic) -> Material { return Material{0, c, roughness, metallic, 0.0, 0.0}; }
fn textured(int texture, float roughness) -> Material { return Material{texture, rgb(1.0, 1.0, 1.0), roughness, 0.0, 0.0, 0.0}; }
// Texture projected in world space: constant texel size on boxes of any size.
fn tiled(int texture, float roughness, float uv_scale) -> Material {
    return Material{texture, rgb(1.0, 1.0, 1.0), roughness, 0.0, 0.0, uv_scale};
}

fn apply_material(Material m) { engine_set_material(m.roughness, m.metallic, m.emissive, m.uv_scale); }
fn reset_material() { engine_set_material(0.6, 0.0, 0.0, 0.0); }

fn draw(int mesh, Mat4 model, Material m) {
    apply_material(m);
    engine_draw_textured(mesh, &model, m.texture, m.color.r, m.color.g, m.color.b);
    reset_material();
}

// ───────────── Animated models ─────────────

// Plays one animation and cross-fades smoothly when switching to another.
struct Animator {
    int model;
    int current;
    int previous;
    float time;
    float previous_time;
    float fade;           // 0..1 progress of the cross-fade
    float fade_seconds;
    float speed;
}

fn animator(int model, int first_animation) -> Animator {
    return Animator{model, first_animation, -1, 0.0, 0.0, 1.0, 0.25, 1.0};
}

fn play(Animator* a, int animation) {
    if (animation == a.current) return;
    a.previous = a.current;
    a.previous_time = a.time;
    a.current = animation;
    a.time = 0.0;
    a.fade = 0.0;
}

fn update(Animator* a, float dt) {
    a.time += dt * a.speed;
    a.previous_time += dt * a.speed;
    if (a.fade < 1.0) a.fade = min(1.0, a.fade + dt / a.fade_seconds);
}

fn draw(Animator* a, Mat4 transform) {
    if (a.fade < 1.0 && a.previous >= 0)
        engine_draw_model_blend(a.model, &transform, a.previous, a.previous_time, a.current, a.time, a.fade);
    else
        engine_draw_model(a.model, &transform, a.current, a.time);
}

// Gives every material of `model` whose name contains one of `keys` the given shading.
// Returns how many materials matched. Example: set_shading(model, ["skin", "face", "body"], SHADING_SKIN)
fn set_shading(int model, u8*[] keys, int shading) -> int {
    int matched = 0;
    for (int m = 0; m < engine_model_material_count(model); m++) {
        u8* name = engine_model_material_name(model, m);
        for (var key in keys) {
            if (__contains_ignore_case(name, key)) {
                engine_model_set_material_flags(model, m, shading);
                matched++;
                break;
            }
        }
    }
    return matched;
}

fn __lower(u8 c) -> u8 { return c >= 65 && c <= 90 ? (c + 32) as u8 : c; }

fn __contains_ignore_case(u8* text, u8* key) -> bool {
    for (int i = 0; text[i] != 0; i++) {
        int k = 0;
        while (key[k] != 0 && text[i + k] != 0 && __lower(text[i + k]) == __lower(key[k])) k++;
        if (key[k] == 0) return true;
    }
    return false;
}

// Sets a morph target (blend shape) by name; returns false if the model has none with that name.
fn set_morph(int model, u8* name, float weight) -> bool {
    int m = engine_model_find_morph(model, name);
    if (m < 0) return false;
    engine_model_set_morph(model, m, weight);
    return true;
}

// ───────────── Procedural textures ─────────────

// A w x h RGBA image you can paint into, then upload with make_texture().
struct Image {
    int width, height;
    u8* pixels;
}

fn image(int width, int height) -> Image {
    return Image{width, height, alloc((width * height * 4) as u64)};
}

fn set_pixel(Image* img, int x, int y, Color c) {
    u8* p = img.pixels + ((y * img.width + x) * 4) as i64;
    p[0] = (clamp(c.r, 0.0, 1.0) * 255.0) as u8;
    p[1] = (clamp(c.g, 0.0, 1.0) * 255.0) as u8;
    p[2] = (clamp(c.b, 0.0, 1.0) * 255.0) as u8;
    p[3] = 255;
}

fn make_texture(Image* img) -> int {
    int t = engine_texture_create(img.width, img.height, img.pixels);
    free(img.pixels);
    img.pixels = null;
    return t;
}

// Smooth value noise in [0, 1] (deterministic, tileable every `period` cells).
fn __hash2(int x, int y) -> float {
    u32 h = (x as u32) * 374761393 + (y as u32) * 668265263;
    h = (h ^ (h >> 13)) * 1274126177;
    return ((h ^ (h >> 16)) & 0xFFFF) as float / 65535.0;
}

fn value_noise(float x, float y, int period) -> float {
    int xi = floor(x) as int;
    int yi = floor(y) as int;
    float fx = x - floor(x);
    float fy = y - floor(y);
    float sx = fx * fx * (3.0 - 2.0 * fx);
    float sy = fy * fy * (3.0 - 2.0 * fy);
    int x0 = ((xi % period) + period) % period;
    int y0 = ((yi % period) + period) % period;
    int x1 = (x0 + 1) % period;
    int y1 = (y0 + 1) % period;
    float a = lerp(__hash2(x0, y0), __hash2(x1, y0), sx);
    float b = lerp(__hash2(x0, y1), __hash2(x1, y1), sx);
    return lerp(a, b, sy);
}

// Fractal noise: several octaves of value noise.
fn fbm(float x, float y, int period) -> float {
    float sum = 0.0;
    float amp = 0.5;
    int p = period;
    for (int i = 0; i < 4; i++) {
        sum += value_noise(x, y, p) * amp;
        x *= 2.0;
        y *= 2.0;
        p *= 2;
        amp *= 0.5;
    }
    return sum;
}
