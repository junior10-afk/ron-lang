// Fast pseudo-random numbers (xorshift64*).

u64 __rng_state = 0x9E3779B97F4A7C15;

fn seed_random(u64 seed) {
    __rng_state = seed == 0 ? 0x9E3779B97F4A7C15 : seed;
}

fn random_u64() -> u64 {
    u64 x = __rng_state;
    x ^= x >> 12;
    x ^= x << 25;
    x ^= x >> 27;
    __rng_state = x;
    return x * 0x2545F4914F6CDD1D;
}

// Uniform float in [0, 1)
fn random() -> float {
    return ((random_u64() >> 40) as float) / 16777216.0;
}

// Uniform float in [lo, hi)
fn random_range(float lo, float hi) -> float { return lo + (hi - lo) * random(); }

// Uniform integer in [lo, hi]
fn random_int(int lo, int hi) -> int {
    u64 span = (hi - lo + 1) as u64;
    return lo + (random_u64() % span) as int;
}
