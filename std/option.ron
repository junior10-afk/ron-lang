// Option<T> and Result<T, E>: values that may be missing or may have failed.
//
//   fn find(int[] xs, int x) -> Option<int> { ...; return Option::None; }
//   fn parse(String s) -> Result<int, u8*> { ...; return Result::Err("bad digit"); }
//
//   match (find(xs, 3)) { Some(i) => ..., None => ... }
//   var n = parse(s)?;          // returns the Err from the current function
//   int i = find(xs, 3).unwrap_or(-1);

import "std/io.ron";
import "std/win32.ron";

enum Option<T> { Some(T), None }
enum Result<T, E> { Ok(T), Err(E) }

fn __option_fail(u8* message) {
    print("panic: ");
    println(message);
    ExitProcess(101);
}

fn is_some<T>(Option<T> o) -> bool {
    match (o) {
        Some(_) => return true;
        None => return false;
    }
}

fn is_none<T>(Option<T> o) -> bool { return !o.is_some(); }

fn unwrap<T>(Option<T> o) -> T {
    match (o) {
        Some(v) => return v;
        None => __option_fail("unwrap() called on Option::None");
    }
    T unreachable;
    return unreachable;
}

fn expect<T>(Option<T> o, u8* message) -> T {
    match (o) {
        Some(v) => return v;
        None => __option_fail(message);
    }
    T unreachable;
    return unreachable;
}

fn unwrap_or<T>(Option<T> o, T fallback) -> T {
    match (o) {
        Some(v) => return v;
        None => return fallback;
    }
}

fn is_ok<T, E>(Result<T, E> r) -> bool {
    match (r) {
        Ok(_) => return true;
        Err(_) => return false;
    }
}

fn is_err<T, E>(Result<T, E> r) -> bool { return !r.is_ok(); }

fn unwrap<T, E>(Result<T, E> r) -> T {
    match (r) {
        Ok(v) => return v;
        Err(_) => __option_fail("unwrap() called on Result::Err");
    }
    T unreachable;
    return unreachable;
}

fn unwrap_err<T, E>(Result<T, E> r) -> E {
    match (r) {
        Ok(_) => __option_fail("unwrap_err() called on Result::Ok");
        Err(e) => return e;
    }
    E unreachable;
    return unreachable;
}

fn unwrap_or<T, E>(Result<T, E> r, T fallback) -> T {
    match (r) {
        Ok(v) => return v;
        Err(_) => return fallback;
    }
}

// Result -> Option (drops the error)
fn ok<T, E>(Result<T, E> r) -> Option<T> {
    match (r) {
        Ok(v) => return Option::Some(v);
        Err(_) => return Option::None;
    }
}
