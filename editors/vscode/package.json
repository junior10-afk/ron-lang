{
  "name": "ron-lang",
  "displayName": "Ron Language",
  "description": "Syntax highlighting for the Ron programming language",
  "version": "0.2.0",
  "publisher": "ron-lang",
  "license": "MIT",
  "engines": { "vscode": "^1.60.0" },
  "categories": ["Programming Languages"],
  "contributes": {
    "languages": [
      {
        "id": "ron",
        "aliases": ["Ron", "ron"],
        "extensions": [".ron"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "ron",
        "scopeName": "source.ron",
        "path": "./syntaxes/ron.tmLanguage.json"
      }
    ]
  }
}
